# Python related ignores
# See: https://help.github.com/articles/ignoring-files/ and https://github.com/github/gitignore

# Virtual environment
venv/
.venv/
.env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.coverage
htmlcov/
coverage.xml

# IDEs
# .vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

!*.py
!*.gitignore